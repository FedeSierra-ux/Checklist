// Tudu — reglas de Firestore (sincronización por código, sin cuentas).
//
// Pegá este archivo en Firebase → Firestore Database → Reglas → Publicar.
//
// Nadie puede LISTAR documentos: sólo leer/escribir uno cuyo id ya conocés.
// El id de un espacio es el código de sincronización (~100 bits de azar) y el
// de una imagen tiene 128 bits de azar, así que sin el código no se llega a
// los datos de nadie aunque la API key sea pública.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Estado sincronizado: rooms/{código} = { data: string JSON, u: int }
    match /rooms/{code} {
      allow get: if code.matches('^[a-z0-9-]{16,64}$');
      allow create, update: if code.matches('^[a-z0-9-]{16,64}$')
        && request.resource.data.keys().hasOnly(['data', 'u'])
        && request.resource.data.data is string
        && request.resource.data.u is int;
      allow list, delete: if false;
    }

    // Imágenes de las notas: imgs/{hash del código}-{azar} = { b64, mime }
    match /imgs/{id} {
      allow get, delete: if id.matches('^[0-9a-f]{24}-[0-9a-f]{32}$');
      allow create: if id.matches('^[0-9a-f]{24}-[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['b64', 'mime'])
        && request.resource.data.b64 is string
        && request.resource.data.b64.size() < 750000
        && request.resource.data.mime in ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
      allow list, update: if false;
    }
  }
}
